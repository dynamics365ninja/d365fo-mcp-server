{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",

  // Biome was added to ~86k lines of TypeScript that had never been linted.
  // The default recommended set produced 3,391 findings, which is a gate nobody
  // can adopt. This config is the subset the repo can actually be held to: the
  // rules left on are ones where a hit is a defect or dead code, and every rule
  // turned off below is listed with the count that made it unadoptable, so the
  // debt is visible rather than silently absent.
  //
  // What the gate covers, and why it is worth having on top of `tsc`:
  // tsconfig.json `include` is "src/**/*" only — tests/ and scripts/ are NOT
  // type-checked at all. `npm run lint` is the only automated check those ~250
  // files get.
  //
  // FORMATTER: configured (so `npm run format` and editor integration produce
  // the house style) but deliberately NOT part of the CI gate — 531 of 535
  // files predate it, and enforcing it would mean a repo-wide reformat that
  // buries every real change and destroys `git blame`. Run `npm run format` on
  // files you are already rewriting; do not sweep.

  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.mjs",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      "!**/node_modules",
      "!dist",
      // Worktrees hold full checkouts of this repo for parallel sessions —
      // without this, a run from the main tree lints every file twice and
      // reports another branch's findings as this branch's. Same reason
      // vitest.config.ts excludes them.
      "!.claude/worktrees",
      "!eval",
      "!instances"
    ]
  },

  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },

  // organizeImports would rewrite the import block of 360 files on first run.
  "assist": { "enabled": false },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      // Counts are from the first full run against 535 files at 585b936.
      "suspicious": {
        // 1,784 hits. `any` is load-bearing here: xml2js returns untyped trees
        // and the C# bridge speaks JSON. Banning it is a refactor, not a lint fix.
        "noExplicitAny": "off",
        // 17 hits, every one the `while ((m = re.exec(s)) !== null)` idiom.
        "noAssignInExpressions": "off",
        // 14 hits, all `forEach(x => sink.push(x))` — concise-arrow style, not bugs.
        "useIterableCallbackReturn": "off",
        // 10 hits, all `let x; try { x = await … } catch { … }`. TypeScript's
        // evolving-any types these soundly under `strict`, so tsc already covers
        // the src/ half and the rule only adds noise.
        "noImplicitAnyLet": "off"
      },

      "style": {
        // 402 hits. `!` is the established way this codebase asserts an index
        // lookup succeeded after an explicit existence check.
        "noNonNullAssertion": "off",
        // 399 hits — bare 'fs'/'path' specifiers throughout. Cosmetic.
        "useNodejsImportProtocol": "off",
        // 154 hits. Much of the string building is deliberate concatenation of
        // XML/X++ fragments where `+` reads better than nested templates.
        "useTemplate": "off",
        "useImportType": "off",
        "useExponentiationOperator": "off"
      },

      "complexity": {
        // 81 hits — the XmlTemplateGenerator static-class pattern.
        "noThisInStatic": "off",
        "useOptionalChain": "off",
        "noBannedTypes": "off",
        // 14 hits inside X++/XML-matching regexes where the redundant escape is
        // intentional documentation of what is being matched.
        "noUselessEscapeInRegex": "off",
        "noStaticOnlyClass": "off",
        "noUselessSwitchCase": "off",
        "noUselessLabel": "off",
        "noUselessContinue": "off",
        "useLiteralKeys": "off",
        "noUselessTernary": "off",
        "useArrowFunction": "off",
        "noUselessConstructor": "off"
      }
    }
  }
}
