# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Configuration written by `npm run setup` (machine-specific, may hold secrets)
config/d365fo-mcp.json
config/secrets.json

# Environment variables (legacy configuration, still read as a fallback)
.env
.env.eval
.env.local
.env.*.local

# Multi-instance data (per-machine, contains .env files, databases, metadata)
instances/*/

# Database files
*.db
*.db-shm
*.db-wal
*.db.tmp
*.db.tmp-shm
*.db.tmp-wal
*.sqlite
*.sqlite3

# Metadata extraction
extracted-metadata/
/metadata/
tmp/

# Test artifacts
test-workspace/
test-model-tags*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# MCP Configuration
.mcp.json
mcp-config-suggestion.json

# OS
.DS_Store
Thumbs.db

# Azure
.azure/

# Testing
# Anchored: an unanchored "coverage/" also matches nested source directories
# (it silently swallowed src/eval/coverage/), so only the root artifact dir.
/coverage/
.nyc_output/

# Internal planning docs
docs/plans/

# C# Bridge build artifacts
bridge/D365MetadataBridge/bin/
bridge/D365MetadataBridge/obj/

# Bridge scratch/debug files
bridge/inspect-*.ps1
bridge/stderr*.log
bridge/D365MetadataBridge/bridge-stderr.log

# Visual Studio solution user files
*.suo
*.user
*.userosscache
*.sln.docstates

# Misc
.cache/
deployment.zip
.claude/settings.local.json

# Transient git worktrees created by Claude Code subagents
.claude/worktrees/

# Local symbol-index databases (multi-GB, rebuilt by `npm run index-metadata`)
data/

# Machine-specific eval-sandbox wiring: absolute VM paths + the throwaway model
# name, same category as config/d365fo-mcp.json above.
config/d365fo-mcp-eval.json

# Oracle harness outputs (scripts/oracles) — measurements, not artefacts.
# The scripts are committed so anyone can re-measure; the results are a snapshot
# of one machine at one platform version and go stale silently.
.oracle-*.json
.oracle-*.log
.oracle-probes/
